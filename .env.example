# Приклад змінних середовища. Скопіюйте у .env і підставте СВОЇ значення.
# НЕ комітьте справжній .env у git!

# Flask
FLASK_SECRET=change_me_to_a_long_random_string

# Google OAuth (вхід через Google)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# Пошта (SMTP)
SMTP_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# База даних (локально можна не вказувати — буде SQLite)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Cloudinary (зберігання фото товарів)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Обмін з 1С/BAF
EXCHANGE_LOGIN=nova_baf
EXCHANGE_PASSWORD=your_exchange_password
# EXCHANGE_PRICE_TYPE_ID=

# Нова Пошта
NOVA_POSHTA_API_KEY=your_nova_poshta_key

# Telegram (сповіщення про замовлення)
ADMIN_TELEGRAM_CHAT_ID=your_chat_id

# ЛОКАЛЬНО ЛИШЕ! Дозволяє OAuth через http на localhost.
# НІКОЛИ не вмикайте на проді (fly).
# OAUTHLIB_INSECURE_TRANSPORT=1
