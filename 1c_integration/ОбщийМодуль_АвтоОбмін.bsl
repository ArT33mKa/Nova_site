// ============================================================================
// Спільний модуль автоматичного (регламентного) вивантаження на сайт.
// Дзеркальний виклик: ЗапуститиАвтоОбчін() — виконати з регламентного/фонового завдання.
//
// Той же протокол, що й у формі ручного вивантаження:
//   1) POST /1c_exchange/sync         — категорії + товари (без фото, лише хеш)
//   2) POST /1c_exchange/push_images  — фото (base64) ЛИШЕ для товарів зі need_images
//
// Фото НЕ вантажається напряму з 1С у Cloudinary — це вантажує сайт (там є
// справжні API-ключі). Див. коментар з причиною на вершині
// ModulFormi_VivantazhennyaNaSayt.bsl.
// ============================================================================

&НаСервере
Функция ОтриматиОбраніГрупи() ФункцииНачалоЗначениеКомпиляции
	Збережений = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "ОбраніГрупи");
	Результат = Новый Массив;
	Если Типзнч(Збережений) <> Тип("Массив") ИЛИ Збережений.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого СтрGUID Из Збережений Цикл
		Попытка
			Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрGUID));
			Если ЗначениеЗаполнено(Ссылка) И Не Ссылка.ПометкаУдаления Тогда
				Результат.Добавить(Ссылка);
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Для автоматичного режиму без КОристувацького вибору: якщо в налаштуваннях
// немає зафіксованих груп — беремо ВСІ кореневі групи номенклатури,
// щоб автообмін завжди надійно вивантажував весь каталог.
&НаСервере
Функция ОтриматиКореневіГрупи() ФункцииНачалоЗначениеКомпиляции
	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ИСТИНА
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Один кондуіт логування автообміну — завжди в журнал реєстрації.
&НаСервере
Процедура ЗаписатиЛог(Текст) ФункцииНачалозначениеКомпиляцииФоступенеСерверНетСовичова
	ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Авто", УровеньЖурналаРегистрации.Информация,,,
		Текст);
КонецПроцедуры

// Окремий кондуіт для помилок/застережень — також в журнал реєстрації, але рівнем "Ошибка",
// щоб відразу був видно, в чому проблема (на відміну від тихого ковтання винятків).
&НаСервере
Процедура ЗаписатиЛогПомилку(Текст) ФункцииНачалозначениеКомпиляциидоступенеСерверНетСовичова
	ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Авто", УровеньЖурналаРегистрации.Ошибка,,,
		Текст);
КонецПроцедуры

// --- Головна точка входу для регламентного/автоматичного завдання ---
// Тей же лінійний потік, що й у ручному вивантаженні: групи → товари →
// ціни/залишки → категорії → sync пакетами → push_images пакетами → лог.
&НаСервере
Функция ЗапуститиАвтоОбчін(АдресаСайту = Неопределено, Ключ = Неопределено, ВидЦіни = Неопределено,
	ВивантажуватиФото = Истина, РозмірПакета = 100, РозмірПакетаФото = 20) функцииНачалозначениеКомпиляцииФоступенесервернетсовичоваЭкспорт

	Адр = ?(ЗначениеЗаполнено(АдресаСайту), АдресаСайту, "https://nova-khvylia.fly.dev");
	Кл = ?(ЗначениеЗаполнено(Ключ), Ключ, "H6kh4HUHnjh8IHB8932Jh");

	// 1) Обрані групи (якщо відсутні в налаштуваннях — беремо ВСІ кореневі)
	ОбраніГрупи = Неопределено;
	ОбраніГрупи = ОтриматиОбраніГрупи();
	Если ОбраніГрупи = Неопределено ИЛИ ОбраніГрупи.Количество() = 0 Тогда
		ОбраніГрупи = ОтриматиКореневіГрупи();
	КонецЕсли;
	Если ОбраніГрупи.Количество() = 0 Тогда
		ЗаписатиЛогПомилку("Немає жодної групи номенклатури для автоматичного вивантаження.");
		Возврат "Немає груп для вивантаження.";
	КонецЕсли;

	// 2) Товари обраних груп (в ієрархії)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Наименование КАК Наименование,
		|	Н.Описание КАК ОписТовару,
		|	Н.Родитель КАК Родитель
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	Н.ЭтоГруппа = ЛОЖЬ
		|	И Н.ПометкаУдаления = ЛОЖЬ
		|	И Н.Ссылка В ИЕРАРХИИ(&Групи)";
	ВыборкаТоварів = Запрос.Выполнить().Выбрать();

	// 3) Ціни та залишки
	ТекстПомилкиЦіни = "";
	ЦіниВідповідність = ОтриматиЦіни(ОбраніГрупи, ВидЦіни, ТекстПомилкиЦіни);
	ЗалишкиВідповідність = ОтриматиЗалишки(ОбраніГрупи);

	// 4) Категорії (обрані групи + батьки + УСІ підпапки)
	КатегоріїМасив = Новый Массив;
	ДодаліГрупи = Новый Соответствие;
	Для Каждого Гр Из ОбраніГрупи Цикл
		ДодатиКатегоріюЗБатьками(Гр, КатегоріїМасив, ДодаліГрупи);
	КонецЦикла;

	// 5) Зібрати дані товарів (без фото, лише хеш)
	КартаНоменклатури = Новый Соответствие;
	Товари = Новый Массив;
	Пока ВыборкаТоварів.Следующий() Цикл
		Ід = XMLСтрока(ВыборкаТоварів.Ссылка.УникальныйИдентификатор());
		КартаНоменклатури.Вставить(Ід, ВыборкаТоварів.Ссылка);

		Товар = Новый Структура;
		Товар.Вставить("id", Ід);
		Товар.Вставить("name", ВыборкаТоварів.Наименование);
		Товар.Вставить("description", СокрЛП(Строка(ВыборкаТоварів.ОписТовару)));
		Товар.Вставить("group_id", XMLСтрока(ВыборкаТоварів.Родитель.УникальныйИдентификатор()));

		Ціна = 0;
		Если ЦіниВідповідність.Получить(ВыборкаТоварів.Ссылка) <> Неопределено Тогда
			Ціна = ЦіниВідповідність.Получить(ВыборкаТоварів.Ссылка);
		КонецЕсли;
		Товар.Вставить("price", Ціна);

		Залишок = 0;
		Если ЗалишкиВідповідність.Получить(ВыборкаТоварів.Ссылка) <> Неопределено Тогда
			Залишок = ЗалишкиВідповідність.Получить(ВыборкаТоварів.Ссылка);
		КонецЕсли;
		Товар.Вставить("stock", ?(Залишок > 0, 1, 0));

		Если ВивантажуватиФото Тогда
			Товар.Вставить("image_hash", ОтриматиХешФото(ВыборкаТоварів.Ссылка));
		КонецЕсли;

		Товари.Добавить(Товар);
	КонецЦикла;

	ВсьогоТоварів = Товари.Количество();

	// 6) Відправити товари+категорії на /sync пакетами; зібрати need_images
	ПотрібніФото = Новый Массив;
	ПакетівТоварів = 0;
	ПозиціяТ = 0;
	ПершийПакет = Истина;
	Пока ПозиціяТ < Товари.Количество() Цикл
		Пакет = Новый Массив;
		Лічильник = 0;
		Пока ПозиціяТ < Товари.Количество() И Лічильник < РозмірПакета Цикл
			Пакет.Добавить(Товари[ПозиціяТ]);
			ПозиціяТ = ПозиціяТ + 1;
			Лічильник = Лічильник + 1;
		КонецЦикла;
		ПакетівТоварів = Пакетів Товарів + 1;
		Відповідь = ВідправитиСинхр(Адр, Кл, ?(ПершийПакет, КатегоріїМасив, Новый Массив), Пакет);
		ЗібратиПотрібніФото(Відповідь, ПотрібніФото);
		ЗаписатиЛог("Sync-пакет " + Строка(ПакетівТоварів) + ": відправлено товарів " + Строка(Пакет.Количество()));
		ПершийПакет = Ложь;
	КонецЦикла;

	// 7) Відправити фото товарів, які сайт попросив (need_images), на /push_images
	УспішноФото = 0;
	ПомилокФото = 0;
	ВсьогоФотоДоВідправки = ПотрібніФото.Количество();
	Если ВивантажуватиФото И ПотрібніФото.Количество() > 0 Тогда
		ПакетФото = Новый Массив;
		Для Каждого ІдФото Из ПотрібніФото Цикл
			СсылкаФото = КартаНоменклатури.Получить(ІдФото);
			Если СсылкаФото = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТекстПомилкиФото = "";
			ФотоДані = ОтриматиФотоBase64(СсылкаФото, ТекстПомилкиФото);
			Если ФотоДані = Неопределено Тогда
				ПомилокФото = ПомилокФото + 1;
				Если Не ПустаяСтрока(ТекстПомилкиФото) Тогда
					ЗаписатиЛогПомилку("Немає фото/помилка читання для " + ІдФото + ": " + ТекстПомилкиФото);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Елемент = Новый Структура;
			Елемент.Вставить("id", ІдФото);
			Елемент.Вставить("image_b64", ФотоДані.Base64);
			Елемент.Вставить("image_ext", ФотоДані.Расширение);
			Елемент.Вставить("image_hash", ФотоДані.Хеш);
			ПакетФото.Добавить(Елемент);
			Если ПакетФото.Количество() >= РозмірПакетаФото Тогда
				РезультатПакета = ВідправитиФото(Адр, Кл, ПакетФото);
				УспішноФото = УспішноФото + РезультатПакета.Успішно;
				ПомилокФото = ПомилокФото + РезультатПакета.Помилок;
				ПакетФото = Новый Массив;
			КонецЕсли;
		КонецЦикла;
		Если ПакетФото.Количество() > 0 Тогда
			РезультатПакета = ВідправитиФото(Адр, Кл, ПакетФото);
			УспішноФото = УспішноФото + РезультатПакета.Успішно;
			ПомилокФото = ПомилокФото + РезультатПакета.Помилок;
		КонецЕсли;
	КонецЕсли;

	// 8) Підсумок
	ПовідомленняРезультату = "Автообмін: товарів " + Строка(ВсьогоТоварів)
		+ " | цін: " + Строка(ЦіниВідповідність.Количество())
		+ " | залишків: " + Строка(ЗалишкиВідповідність.Количество())
		+ " | фото потрібно було: " + Строка(ВсьогоФотоДоВідправки)
		+ " | фото завантажено: " + Строка(УспішноФото)
		+ " | фото з помилкою: " + Строка(ПомилокФото);
	Если Не ПустаяСтрока(ТекстПомилкиЦіни) Тогда
		ПовідомленняРезультату = ПовідомленняРезультату + " | ПОМИЛКА ЦІН: " + ТекстПомилкиЦіни;
	КонецЕсли;

	ЗаписатиЛог(ПовідомленняРезультату);
	Возврат ПовідомленняРезультату;

КонецФункции

// Додає категорію, всіх її батьків (до кореня), а також УСІ підпапки
// (дочірні групи) рекурсивно — щоб категорії на сайті повторювали структуру
// Номенклатури з підпапками. НЕ ЗМІНЕНО (ця частина вже працює коректно).
&НаСервере
Процедура ДодатиКатегоріюЗБатьками(Група, КатегоріїМасив, ДодаліГрупи) Экспорт
	Если Група = Неопределено ИЛИ Не ЗначениеЗаполнено(Група) Тогда
		Возврат;
	КонецЕсли;
	Гуид = XMLСтрока(Група.УникальныйИдентификатор());
	Если ДодаліГрупи.Получить(Гуид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДодаліГрупи.Вставить(Гуид, Истина);

	Кат = Новый Структура;
	Кат.Вставить("id", Гуид);
	Кат.Вставить("name", Група.Наименование);
	Батько = Група.Родитель;
	Если ЗначениеЗаполнено(Батько) Тогда
		Кат.Вставить("parent_id", XMLСтрока(Батько.УникальныйИдентификатор()));
		ДодатиКатегоріюЗБатьками(Батько, КатегоріїМасив, ДодаліГрупи);
	Иначе
		Кат.Вставить("parent_id", "");
	КонецЕсли;
	КатегоріїМасив.Добавить(Кат);

	// Рекурсивно додаємо усі підпапки (дочірні групи) цієї групи
	ЗапросПідгруп = Новый Запрос;
	ЗапросПідгруп.УстановитьПараметр("Батько", Група);
	ЗапросПідгруп.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Группа
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ИСТИНА
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.Родитель = &Батько";
	ВыборкаПідгруп = ЗапросПідгруп.Выполнить().Выбрать();
	Пока ВыборкаПідгруп.Следующий() Цикл
		ДодатиКатегоріюЗБатьками(ВыборкаПідгруп.Группа, КатегоріїМасив, ДодаліГрупи);
	КонецЦикла;
КонецПроцедуры

// --- Ціни ---  // <<< ПЕРЕВІРИТИ назву регістру та реквізитів
&НаСервере
Функция ОтриматиЦіни(ОбраніГрупи, ВидЦіни, ТекстПомилки = "") Экспорт
	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
		Запрос.УстановитьПараметр("ВидЦіни", ВидЦіни);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Ціни.Номенклатура КАК Номенклатура,
			|	Ціни.Цена КАК Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &ВидЦіни) КАК Ціни
			|ГДЕ
			|	Ціни.Номенклатура В ИЕРАРХИИ(&Групи)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Номенклатура, Число(Выборка.Цена));
		КонецЦикла;
	Исключение
		ТекстПомилки = ОписаниеОшибки();
		ЗаписатиЛогПомилку("Помилка отримання цін: " + ТекстПомилки);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// --- Залишки ---  // <<< ПЕРЕВІРИТИ назву регістру залишків
&НаСервере
Функция ОтриматиЗалишки(ОбраніГрупи) Экспорт
	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Залишки.Номенклатура КАК Номенклатура,
			|	Залишки.ВНаличииОстаток КАК Кількість
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК Залишки
			|ГДЕ
			|	Залишки.Номенклатура В ИЕРАРХИИ(&Групи)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Номенклатура, Число(Выборка.Кількість));
		КонецЦикла;
	Исключение
		ЗаписатиЛогПомилку("Помилка отримання залишків: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// --- Фото у Base64 ---  // <<< ПЕРЕВІРИТИ назву довідника приєднаних файлів та поле власника
// ВИПРАВЛЕНО: прибираємо CR/LF з Base64Строка() (1С може вертати MIME-формат
// з переносами рядків кожні 76 символів) — це один з кандидатів на "тихе"
// пошкодження зображення при передачі через JSON.
&НаСервере
Функция ОтриматиФотоBase64(Номенклатура, ТекстПомилки = "") Экспорт
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Влад", Номенклатура);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Файли.Ссылка КАК Файл,
			|	Файли.Расширение КАК Расширение
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файли
			|ГДЕ
			|	Файли.ВладелецФайла = &Влад
			|	И Файли.ПометкаУдаления = ЛОЖЬ
			|	И НРЕГ(Файли.Расширение) В (""jpg"", ""jpeg"", ""jfif"", ""png"", ""gif"", ""webp"", "".jpg"", "".jpeg"", "".jfif"", "".png"", "".gif"", "".webp"")
			|УПОРЯДОЧИТЬ ПО
			|	Файли.УниверсальнаяДатаМодификации УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ТекстПомилки = "У товару немає прикріпленого файлу-зображення";
			Возврат Неопределено;
		КонецЕсли;
		ДвоичніДані = ПрисоединенныеФайлы.ПолучитьДвоичныеДанныеФайла(Выборка.Файл);
		Если ДвоичніДані = Неопределено Тогда
			ТекстПомилки = "Не вдалося отримати бінарні дані файлу";
			Возврат Неопределено;
		КонецЕсли;
		Base64Рядок = Base64Строка(ДвоичніДані);
		Base64Рядок = СтрЗаменить(СтрЗаменить(Base64Рядок, Символ(13), ""), Символ(10), "");
		Результат = Новый Структура;
		Результат.Вставить("Base64", Base64Рядок);
		Результат.Вставить("Хеш", ОтриматиХешФото(Номенклатура));
		Расш = СтрЗаменить(НРег(Выборка.Расширение), ".", "");
		Результат.Вставить("Расширение", ?(ПустаяСтрока(Расш), "jpg", Расш));
		Возврат Результат;
	Исключение
		ТекстПомилки = ОписаниеОшибки();
		ЗаписатиЛогПомилку("Помилка читання фото: " + ТекстПомилки);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// --- "Версія" фото за метаданими (Розмір + ДатаМодифікації) — БЕЗ читання
// бінарних даних. НЕ ЗМІНЕНО.
&НаСервере
Функция ОтриматиХешФото(Номенклатура) Экспорт
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Влад", Номенклатура);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Файли.Размер КАК Размер,
			|	Файли.УниверсальнаяДатаМодификации КАК ДатаМод
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файли
			|ГДЕ
			|	Файли.ВладелецФайла = &Влад
			|	И Файли.ПометкаУдаления = ЛОЖЬ
			|	И НРЕГ(Файли.Расширение) В (""jpg"", ""jpeg"", ""jfif"", ""png"", ""gif"", ""webp"", "".jpg"", "".jpeg"", "".jfif"", "".png"", "".gif"", "".webp"")
			|УПОРЯДОЧИТЬ ПО
			|	Файли.УниверсальнаяДатаМодификации УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Возврат "";
		КонецЕсли;
		Возврат Формат(Выборка.ДатаМод, "ДФ=yyyyMMddHHmmss; ДЛ=") + "_" + Формат(Выборка.Размер, "ЧГ=0");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// --- Універсальна відправка JSON на сайт ---  // НЕ ЗМІНЕНО
&НаСервере
Функция ВідправитиJSON(Адреса, Ключ, ВідноснийШлях, СтруктураДаних) Экспорт
	Записувач = Новый ЗаписьJSON;
	Потік = Новый ПотокВПамяти;
	Записувач.ОткрытьПоток(Потік, КодировкаТекста.UTF8);
	ЗаписатьJSON(Записувач, СтруктураДаних);
	Записувач.Закрыть();
	ТілоРядок = ПолучитьСтрокуИзДвоичныхДанных(Потік.ЗакрытьИПолучитьДвоичныеДанные(),
		КодировкаТекста.UTF8);

	URL = Адреса + ВідноснийШлях + "?key=" + Ключ;
	Соединение = ПодключитисяHTTP(URL);
	Запит = Новый HTTPЗапрос(ШляхHTTP(URL));
	Запит.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запит.УстановитьТелоИзСтроки(ТілоРядок, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(Запит);
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// Фаза 1: дані + хеші (без фото)
&НаСервере
Функция ВідправитиСинхр(Адреса, Ключ, КатегоріїМасив, ПакетТоварів) Экспорт
	Дані = Новый Структура;
	Дані.Вставить("categories", КатегоріїМасив);
	Дані.Вставить("products", ПакетТоварів);
	Возврат ВідправитиJSON(Адреса, Ключ, "/1c_exchange/sync", Дані);
КонецФункции

// Фаза 2: фото. Повертає Структуру(Успішно, Помилок) для цього пакета.
&НаСервере
Функция ВідправитиФото(Адреса, Ключ, ПакетФото) Экспорт
	Результат = Новый Структура("Успішно, Помилок", 0, ПакетФото.Количество());
	Дані = Новый Структура;
	Дані.Вставить("images", ПакетФото);
	Попытка
		Відповідь = ВідправитиJSON(Адреса, Ключ, "/1c_exchange/push_images", Дані);
	Исключение
		ЗаписатиЛогПомилку("Помилка HTTP-запиту push_images: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Відповідь);
		СтруктураВідповіді = ПрочитатьJSON(Чтение, Истина);
		Успішно = 0;
		Если СтруктураВідповіді.Получить("images") <> Неопределено Тогда
			Успішно = Число(СтруктураВідповіді.Получить("images"));
		КонецЕсли;
		Результат.Успішно = Успішно;
		Результат.Помилок = ПакетФото.Количество() - Успішно;
		Если СтруктураВідповіді.Получить("status") = "error" Тогда
			ЗаписатиЛогПомилку("Сайт повернув помилку push_images: " + Відповідь);
		КонецЕсли;
	Исключение
		ЗаписатиЛогПомилку("Не вдалося розібрати відповідь push_images: " + ОписаниеОшибки() + " | Відповідь: " + Відповідь);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Розібрати need_images з відповіді /sync і додати у масив  // НЕ ЗМІНЕНО
&НаСервере
Процедура ЗібратиПотрібніФото(Відповідь, ПотрібніФото) Экспорт
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Відповідь);
		СтруктураВідповіді = ПрочитатьJSON(Чтение, Истина);
		Список = СтруктураВідповіді.Получить("need_images");
		Если ТипЗнч(Список) = Тип("Массив") Тогда
			Для Каждого Ід Из Список Цикл
				ПотрібніФото.Добавить(Ід);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписатиЛогПомилку("Не вдалося розібрати відповідь sync: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// --- HTTP-допоміжні функції ---  // НЕ ЗМІНЕНО
&НаСервере
Функция ПодключитисяHTTP(URL) Экспорт
	URLСтруктура = РазобратьURL(URL);
	Защищене = (URLСтруктура.Схема = "https");
	Порт = ?(Защищене, 443, 80);
	ЗащищенеСоединение = ?(Защищене, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(URLСтруктура.Хост, Порт, , , , 120, ЗащищенеСоединение);
	Возврат Соединение;
КонецФункции

&НаСервере
Функция ШляхHTTP(URL) Экспорт
	URLСтруктура = РазобратьURL(URL);
	Возврат URLСтруктура.Шлях;
КонецФункции

&НаСервере
Функция РазобратьURL(URL) Экспорт
	Робоча = URL;
	Схема = "http";
	Если СтрНачинаетсяС(НРег(Робоча), "https://") Тогда
		Схема = "https";
		Робоча = Сред(Робоча, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Робоча), "http://") Тогда
		Схема = "http";
		Робоча = Сред(Робоча, 8);
	КонецЕсли;
	ПозиціяСлеша = Найти(Робоча, "/");
	Если ПозиціяСлеша = 0 Тогда
		Хост = Робоча;
		Шлях = "/";
	Иначе
		Хост = Лев(Робоча, ПозиціяСлеша - 1);
		Шлях = Сред(Робоча, ПозиціяСлеша);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Шлях", Шлях);
	Возврат Результат;
КонецФункции
