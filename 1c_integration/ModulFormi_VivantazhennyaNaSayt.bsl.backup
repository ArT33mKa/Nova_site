// ============================================================================
// Обробка "ВивантаженняНаСайтНоваХвиля" — модуль форми
// Вивантажує обрані групи номенклатури (каталог + ціни + залишки + фото)
// на сайт https://nova-khvylia.fly.dev кастомним JSON-протоколом обміну:
//
//   1) POST /1c_exchange/sync         — категорії + товари (без фото, лише
//                                        хеш поточного фото). Повертає
//                                        need_images — список ід товарів,
//                                        для яких сайту потрібне фото.
//   2) POST /1c_exchange/push_images  — фото (base64) ЛИШЕ для товарів зі
//                                        списку need_images.
//
// Фото НЕ вантажаться напряму з 1С у Cloudinary. Усі фото йдуть через сайт
// (/push_images), бо саме там налаштовані справжні API-ключі Cloudinary.
// Це і є ключова відмінність від попередньої версії — раніше 1С намагалась
// вантажити фото прямо у Cloudinary через unsigned upload preset, і саме
// цей шлях був єдиним, який реально виконувався (бо змінні хмари/пресету
// були жорстко прописані в коді) — а він же й не працював, тому фото не
// потрапляли НІКУДИ. Тепер лишився один надійний потік.
//
// НАЛАШТУВАННЯ зберігаються у Сховищі загальних налаштувань (вид ціни, фото,
// розмір пакета та обрані групи). Адреса і ключ жорстко зашиті в код.
//
// УВАГА: рядки з позначкою // <<< ПЕРЕВІРИТИ можуть відрізнятися у твоїй
// конфігурації BAS УТ. Перевір назви регістрів/реквізитів.
// ============================================================================

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Адреса і ключ фіксовані в коді — щоб НІКОЛИ не збивались на чужі значення
	АдресаСайту = "https://nova-khvylia.fly.dev";
	Ключ = "H6kh4HUHnjh8IHB8932Jh";
	Если Не ЗначениеЗаполнено(РозмірПакета) Тогда
		РозмірПакета = 100;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(РозмірПакетаФото) Тогда
		РозмірПакетаФото = 20;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВивантажуватиФото) Тогда
		ВивантажуватиФото = Истина;
	КонецЕсли;
	ЗаполнитьСписокГруппСервер();
	ЗавантажитиНалаштування();
КонецПроцедуры

// Заповнює таблицю груп номенклатури (лише кореневі/головні групи)
&НаСервере
Процедура ЗаполнитьСписокГруппСервер()
	ТаблицяГруп.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Группа,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ИСТИНА
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.Родитель = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ТаблицяГруп.Добавить();
		Строка.Группа = Выборка.Группа;
		Строка.Наименование = Выборка.Наименование;
		Строка.Позначка = Ложь;
	КонецЦикла;
КонецПроцедуры

// --- Налаштування: завантаження та збереження ---
&НаСервере
Процедура ЗавантажитиНалаштування()
	Збережений = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "ВидЦіни");
	Если Збережений <> Неопределено Тогда
		ВидЦіни = Збережений;
	КонецЕсли;
	Збережений = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "ВивантажуватиФото");
	Если Збережений <> Неопределено Тогда
		ВивантажуватиФото = Збережений;
	КонецЕсли;
	Збережений = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "РозмірПакета");
	Если ЗначениеЗаполнено(Збережений) Тогда
		РозмірПакета = Збережений;
	КонецЕсли;
	Збережений = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "РозмірПакетаФото");
	Если ЗначениеЗаполнено(Збережений) Тогда
		РозмірПакетаФото = Збережений;
	КонецЕсли;
	ВідновитиОбраніГрупи();
КонецПроцедуры

// Відновлює галочки на раніше обраних групах
&НаСервере
Процедура ВідновитиОбраніГрупи()
	ОбраніGUID = ХранилищеОбщихНастроек.Загрузить("ВивантаженняНаСайт", "ОбраніГрупи");
	Если ТипЗнч(ОбраніGUID) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	МножинаGUID = Новый Соответствие;
	Для Каждого Г Из ОбраніGUID Цикл
		МножинаGUID.Вставить(Г, Истина);
	КонецЦикла;
	Для Каждого Стр Из ТаблицяГруп Цикл
		ГуидРядок = XMLСтрока(Стр.Группа.УникальныйИдентификатор());
		Если МножинаGUID.Получить(ГуидРядок) <> Неопределено Тогда
			Стр.Позначка = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗберегтиНалаштування()
	ХранилищеОбщихНастроек.Сохранить("ВивантаженняНаСайт", "ВидЦіни", ВидЦіни);
	ХранилищеОбщихНастроек.Сохранить("ВивантаженняНаСайт", "ВивантажуватиФото", ВивантажуватиФото);
	ХранилищеОбщихНастроек.Сохранить("ВивантаженняНаСайт", "РозмірПакета", РозмірПакета);
	ХранилищеОбщихНастроек.Сохранить("ВивантаженняНаСайт", "РозмірПакетаФото", РозмірПакетаФото);
	ОбраніGUID = Новый Массив;
	Для Каждого Стр Из ТаблицяГруп Цикл
		Если Стр.Позначка Тогда
			ОбраніGUID.Добавить(XMLСтрока(Стр.Группа.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить("ВивантаженняНаСайт", "ОбраніГрупи", ОбраніGUID);
КонецПроцедуры

// --- Команди форми ---
&НаКлиенте
Процедура ОновитиСписокГруп(Команда)
	ОновитиТаблицюГрупСервер();
КонецПроцедуры

&НаСервере
Процедура ОновитиТаблицюГрупСервер()
	ЗаполнитьСписокГруппСервер();
	ВідновитиОбраніГрупи();
КонецПроцедуры

&НаКлиенте
Процедура ЗберегтиНалаштуванняКоманда(Команда)
	ЗберегтиНалаштування();
	ПоказатьПредупреждение(, "Налаштування збережено.");
КонецПроцедуры

// --- Головна команда — Вивантажити ---
// Один клік = один лінійний потік:
//   1) зібрати обрані групи (якщо жодної не обрано — беремо ВСІ кореневі
//      групи, щоб кнопка завжди надійно вивантажувала весь каталог)
//   2) зібрати категорії (з підпапками) і товари (з цінами й залишками)
//   3) відправити категорії+товари на /1c_exchange/sync пакетами
//   4) відправити фото товарів, які сайт попросив (need_images), на
//      /1c_exchange/push_images
//   5) показати і залогувати детальний підсумок
&НаКлиенте
Процедура Вивантажити(Команда)
	Результат = ВивантажитиНаСервере();
	ПоказатьПредупреждение(, Результат);
КонецПроцедуры

&НаСервере
Функция ВивантажитиНаСервере()

	ЗберегтиНалаштування();

	// 1) Обрані групи (якщо нічого не обрано — беремо ВСІ кореневі групи)
	ОбраніГрупи = Новый Массив;
	Для Каждого Стр Из ТаблицяГруп Цикл
		Если Стр.Позначка Тогда
			ОбраніГрупи.Добавить(Стр.Группа);
		КонецЕсли;
	КонецЦикла;
	Если ОбраніГрупи.Количество() = 0 Тогда
		Для Каждого Стр Из ТаблицяГруп Цикл
			ОбраніГрупи.Добавить(Стр.Группа);
		КонецЦикла;
	КонецЕсли;
	Если ОбраніГрупи.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт", УровеньЖурналаРегистрации.Предупреждение,,,
			"Немає жодної групи номенклатури для вивантаження.");
		Возврат "Немає жодної групи номенклатури для вивантаження.";
	КонецЕсли;

	// 2) Товари обраних груп (в ієрархії) — ця вибірка НЕ змінена
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Н.Ссылка КАК Ссылка,
		|	Н.Наименование КАК Наименование,
		|	Н.Описание КАК ОписТовару,
		|	Н.Родитель КАК Родитель
		|ИЗ
		|	Справочник.Номенклатура КАК Н
		|ГДЕ
		|	Н.ЭтоГруппа = ЛОЖЬ
		|	И Н.ПометкаУдаления = ЛОЖЬ
		|	И Н.Ссылка В ИЕРАРХИИ(&Групи)";
	ВыборкаТоварів = Запрос.Выполнить().Выбрать();

	ПопередженняЦіни = "";
	Если Не ЗначениеЗаполнено(ВидЦіни) Тогда
		ПопередженняЦіни = " | УВАГА: не обрано Вид ціни — усі ціни будуть 0, товари не покажуться на сайті!";
	КонецЕсли;

	// 3) Ціни та залишки
	ТекстПомилкиЦіни = "";
	ЦіниВідповідність = ОтриматиЦіни(ОбраніГрупи, ТекстПомилкиЦіни);
	ЗалишкиВідповідність = ОтриматиЗалишки(ОбраніГрупи);

	// 4) Категорії (обрані групи + їх батьки + УСІ підпапки) — НЕ змінено
	КатегоріїМасив = Новый Массив;
	ДодаліГрупи = Новый Соответствие;
	Для Каждого Гр Из ОбраніГрупи Цикл
		ДодатиКатегоріюЗБатьками(Гр, КатегоріїМасив, ДодаліГрупи);
	КонецЦикла;

	// 5) Зібрати дані товарів (без фото, лише хеш поточного фото)
	КартаНоменклатури = Новый Соответствие; // id -> Ссылка (потрібно лише для фази фото)
	Товари = Новый Массив;
	Пока ВыборкаТоварів.Следующий() Цикл
		Ід = XMLСтрока(ВыборкаТоварів.Ссылка.УникальныйИдентификатор());
		КартаНоменклатури.Вставить(Ід, ВыборкаТоварів.Ссылка);

		Товар = Новый Структура;
		Товар.Вставить("id", Ід);
		Товар.Вставить("name", ВыборкаТоварів.Наименование);
		Товар.Вставить("description", СокрЛП(Строка(ВыборкаТоварів.ОписТовару)));
		Товар.Вставить("group_id", XMLСтрока(ВыборкаТоварів.Родитель.УникальныйИдентификатор()));

		Ціна = 0;
		Если ЦіниВідповідність.Получить(ВыборкаТоварів.Ссылка) <> Неопределено Тогда
			Ціна = ЦіниВідповідність.Получить(ВыборкаТоварів.Ссылка);
		КонецЕсли;
		Товар.Вставить("price", Ціна);

		Залишок = 0;
		Если ЗалишкиВідповідність.Получить(ВыборкаТоварів.Ссылка) <> Неопределено Тогда
			Залишок = ЗалишкиВідповідність.Получить(ВыборкаТоварів.Ссылка);
		КонецЕсли;
		Товар.Вставить("stock", ?(Залишок > 0, 1, 0));

		Если ВивантажуватиФото Тогда
			Товар.Вставить("image_hash", ОтриматиХешФото(ВыборкаТоварів.Ссылка));
		КонецЕсли;

		Товари.Добавить(Товар);
	КонецЦикла;

	ВсьогоТоварів = Товари.Количество();

	// 6) Відправити товари+категорії на /sync пакетами; зібрати need_images
	ПотрібніФото = Новый Массив;
	ПакетівТоварів = 0;
	ПозиціяТ = 0;
	ПершийПакет = Истина;
	Пока ПозиціяТ < Товари.Количество() Цикл
		Пакет = Новый Массив;
		Лічильник = 0;
		Пока ПозиціяТ < Товари.Количество() И Лічильник < РозмірПакета Цикл
			Пакет.Добавить(Товари[ПозиціяТ]);
			ПозиціяТ = ПозиціяТ + 1;
			Лічильник = Лічильник + 1;
		КонецЦикла;
		ПакетівТоварів = ПакетівТоварів + 1;
		Відповідь = ВідправитиСинхр(?(ПершийПакет, КатегоріїМасив, Новый Массив), Пакет);
		ЗібратиПотрібніФото(Відповідь, ПотрібніФото);
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Sync", УровеньЖурналаРегистрации.Информация,,,
			"Пакет " + Строка(ПакетівТоварів) + ": відправлено товарів " + Строка(Пакет.Количество()));
		ПершийПакет = Ложь;
	КонецЦикла;

	// 7) Відправити фото товарів, які сайт попросив (need_images), на /push_images
	УспішноФото = 0;
	ПомилокФото = 0;
	ВсьогоФотоДоВідправки = ПотрібніФото.Количество();
	Если ВивантажуватиФото И ПотрібніФото.Количество() > 0 Тогда
		РозмірФото = ?(ЗначениеЗаполнено(РозмірПакетаФото), РозмірПакетаФото, 20);
		ПакетФото = Новый Массив;
		Для Каждого ІдФото Из ПотрібніФото Цикл
			СсылкаФото = КартаНоменклатури.Получить(ІдФото);
			Если СсылкаФото = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТекстПомилкиФото = "";
			ФотоДані = ОтриматиФотоBase64(СсылкаФото, ТекстПомилкиФото);
			Если ФотоДані = Неопределено Тогда
				ПомилокФото = ПомилокФото + 1;
				Если Не ПустаяСтрока(ТекстПомилкиФото) Тогда
					ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Фото", УровеньЖурналаРегистрации.Предупреждение,,,
						"Немає фото або помилка читання для " + ІдФото + ": " + ТекстПомилкиФото);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Елемент = Новый Структура;
			Елемент.Вставить("id", ІдФото);
			Елемент.Вставить("image_b64", ФотоДані.Base64);
			Елемент.Вставить("image_ext", ФотоДані.Расширение);
			Елемент.Вставить("image_hash", ФотоДані.Хеш);
			ПакетФото.Добавить(Елемент);
			Если ПакетФото.Количество() >= РозмірФото Тогда
				РезультатПакета = ВідправитиФото(ПакетФото);
				УспішноФото = УспішноФото + РезультатПакета.Успішно;
				ПомилокФото = ПомилокФото + РезультатПакета.Помилок;
				ПакетФото = Новый Массив;
			КонецЕсли;
		КонецЦикла;
		Если ПакетФото.Количество() > 0 Тогда
			РезультатПакета = ВідправитиФото(ПакетФото);
			УспішноФото = УспішноФото + РезультатПакета.Успішно;
			ПомилокФото = ПомилокФото + РезультатПакета.Помилок;
		КонецЕсли;
	КонецЕсли;

	// 8) Підсумок — і на екран, і в журнал реєстрації
	ПовідомленняРезультату = "Вивантажено товарів: " + Строка(ВсьогоТоварів)
		+ " | цін знайдено: " + Строка(ЦіниВідповідність.Количество())
		+ " | залишків: " + Строка(ЗалишкиВідповідність.Количество())
		+ " | фото потрібно було: " + Строка(ВсьогоФотоДоВідправки)
		+ " | фото завантажено: " + Строка(УспішноФото)
		+ " | фото з помилкою: " + Строка(ПомилокФото)
		+ ПопередженняЦіни;
	Если Не ПустаяСтрока(ТекстПомилкиЦіни) Тогда
		ПовідомленняРезультату = ПовідомленняРезультату + " | ПОМИЛКА ЦІН: " + ТекстПомилкиЦіни;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ВивантаженняНаСайт", УровеньЖурналаРегистрации.Информация,,,
		ПовідомленняРезультату);

	Возврат ПовідомленняРезультату;

КонецФункции

// Додає категорію, всіх її батьків (до кореня), а також УСІ ПІДПАПКИ
// (дочірні групи) рекурсивно — щоб категорії на сайті повторювали структуру
// Номенклатури з підпапками. НЕ ЗМІНЕНО (ця частина вже працює коректно).
&НаСервере
Процедура ДодатиКатегоріюЗБатьками(Група, КатегоріїМасив, ДодаліГрупи)
	Если Група = Неопределено ИЛИ Не ЗначениеЗаполнено(Група) Тогда
		Возврат;
	КонецЕсли;
	Гуид = XMLСтрока(Група.УникальныйИдентификатор());
	Если ДодаліГрупи.Получить(Гуид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДодаліГрупи.Вставить(Гуид, Истина);

	Кат = Новый Структура;
	Кат.Вставить("id", Гуид);
	Кат.Вставить("name", Група.Наименование);
	Батько = Група.Родитель;
	Если ЗначениеЗаполнено(Батько) Тогда
		Кат.Вставить("parent_id", XMLСтрока(Батько.УникальныйИдентификатор()));
		ДодатиКатегоріюЗБатьками(Батько, КатегоріїМасив, ДодаліГрупи);
	Иначе
		Кат.Вставить("parent_id", "");
	КонецЕсли;
	КатегоріїМасив.Добавить(Кат);

	// Рекурсивно додаємо усі підпапки (дочірні групи) цієї групи
	ЗапросПідгруп = Новый Запрос;
	ЗапросПідгруп.УстановитьПараметр("Батько", Група);
	ЗапросПідгруп.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Група
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ИСТИНА
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		|	И Номенклатура.Родитель = &Батько";
	ВыборкаПідгруп = ЗапросПідгруп.Выполнить().Выбрать();
	Пока ВыборкаПідгруп.Следующий() Цикл
		ДодатиКатегоріюЗБатьками(ВыборкаПідгруп.Група, КатегоріїМасив, ДодаліГрупи);
	КонецЦикла;
КонецПроцедуры

// --- Ціни ---  // <<< ПЕРЕВІРИТИ назву регістру та реквізитів
&НаСервере
Функция ОтриматиЦіни(ОбраніГрупи, ТекстПомилки = "")
	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
		Запрос.УстановитьПараметр("ВидЦіни", ВидЦіни);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Ціни.Номенклатура КАК Номенклатура,
			|	Ціни.Цена КАК Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &ВидЦіни) КАК Ціни
			|ГДЕ
			|	Ціни.Номенклатура В ИЕРАРХИИ(&Групи)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Номенклатура, Число(Выборка.Цена));
		КонецЦикла;
	Исключение
		ТекстПомилки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Ціни", УровеньЖурналаРегистрации.Ошибка,,,
			ТекстПомилки);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// --- Залишки ---  // <<< ПЕРЕВІРИТИ назву регістру залишків
&НаСервере
Функция ОтриматиЗалишки(ОбраніГрупи)
	Результат = Новый Соответствие;
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Групи", ОбраніГрупи);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Залишки.Номенклатура КАК Номенклатура,
			|	Залишки.ВНаличииОстаток КАК Кількість
			|ИЗ
			|	РегистрНакопления.ТоварыНаСкладах.Остатки КАК Залишки
			|ГДЕ
			|	Залишки.Номенклатура В ИЕРАРХИИ(&Групи)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Номенклатура, Число(Выборка.Кількість));
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Залишки", УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;
КонецФункции

// --- Фото у Base64 ---  // <<< ПЕРЕВІРИТИ назву довідника приєднаних файлів та поле власника
// ВИПРАВЛЕНО: прибираємо CR/LF з Base64Строка() (1С може повертати MIME-формат
// з переносами рядків кожні 76 символів) — це один з кандидатів на "тихе"
// пошкодження зображення при передачі через JSON.
&НаСервере
Функция ОтриматиФотоBase64(Номенклатура, ТекстПомилки = "")
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Влад", Номенклатура);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Файли.Ссылка КАК Файл,
			|	Файли.Расширение КАК Расширение
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файли
			|ГДЕ
			|	Файли.ВладелецФайла = &Влад
			|	И Файли.ПометкаУдаления = ЛОЖЬ
			|	И НРЕГ(Файли.Расширение) В (""jpg"", ""jpeg"", ""jfif"", ""png"", ""gif"", ""webp"", "".jpg"", "".jpeg"", "".jfif"", "".png"", "".gif"", "".webp"")
			|УПОРЯДОЧИТЬ ПО
			|	Файли.УниверсальнаяДатаМодификации УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			ТекстПомилки = "У товару немає прикріпленого файлу-зображення";
			Возврат Неопределено;
		КонецЕсли;
		ДвоичніДані = ПрисоединенныеФайлы.ПолучитьДвоичныеДанныеФайла(Выборка.Файл);
		Если ДвоичніДані = Неопределено Тогда
			ТекстПомилки = "Не вдалося отримати бінарні дані файлу";
			Возврат Неопределено;
		КонецЕсли;
		Base64Рядок = Base64Строка(ДвоичніДані);
		Base64Рядок = СтрЗаменить(СтрЗаменить(Base64Рядок, Символ(13), ""), Символ(10), "");
		Результат = Новый Структура;
		Результат.Вставить("Base64", Base64Рядок);
		Результат.Вставить("Хеш", ОтриматиХешФото(Номенклатура));  // версія = та сама, що й у /sync (консистентно)
		Расш = СтрЗаменить(НРег(Выборка.Расширение), ".", "");
		Результат.Вставить("Расширение", ?(ПустаяСтрока(Расш), "jpg", Расш));
		Возврат Результат;
	Исключение
		ТекстПомилки = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Фото", УровеньЖурналаРегистрации.Ошибка,,,
			ТекстПомилки);
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// --- "Версія" фото за метаданими (Розмір + ДатаМодифікації) — БЕЗ читання бінарних даних ---
// НЕ ЗМІНЕНО: це прибирає головний гальмівник (раніше на кожному обміні
// читались УСІ фото цілком лише для перевірки версії).
&НаСервере
Функция ОтриматиХешФото(Номенклатура)
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Влад", Номенклатура);
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Файли.Размер КАК Размер,
			|	Файли.УниверсальнаяДатаМодификации КАК ДатаМод
			|ИЗ
			|	Справочник.НоменклатураПрисоединенныеФайлы КАК Файли
			|ГДЕ
			|	Файли.ВладелецФайла = &Влад
			|	И Файли.ПометкаУдаления = ЛОЖЬ
			|	И НРЕГ(Файли.Расширение) В (""jpg"", ""jpeg"", ""jfif"", ""png"", ""gif"", ""webp"", "".jpg"", "".jpeg"", "".jfif"", "".png"", "".gif"", "".webp"")
			|УПОРЯДОЧИТЬ ПО
			|	Файли.УниверсальнаяДатаМодификации УБЫВ";  // <<< ПЕРЕВІРИТИ назви полів (Размер / УниверсальнаяДатаМодификации); беремо лише зображення
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Возврат "";
		КонецЕсли;
		Возврат Формат(Выборка.ДатаМод, "ДФ=yyyyMMddHHmmss; ДЛ=") + "_" + Формат(Выборка.Размер, "ЧГ=0");
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// --- Універсальна відправка JSON на сайт ---  // НЕ ЗМІНЕНО
&НаСервере
Функция ВідправитиJSON(ВідноснийШлях, СтруктураДаних)
	Записувач = Новый ЗаписьJSON;
	Потік = Новый ПотокВПамяти;
	Записувач.ОткрытьПоток(Потік, КодировкаТекста.UTF8);
	ЗаписатьJSON(Записувач, СтруктураДаних);
	Записувач.Закрыть();
	ТілоРядок = ПолучитьСтрокуИзДвоичныхДанных(Потік.ЗакрытьИПолучитьДвоичныеДанные(),
		КодировкаТекста.UTF8);

	URL = АдресаСайту + ВідноснийШлях + "?key=" + Ключ;
	Соединение = ПодключитисяHTTP(URL);
	Запит = Новый HTTPЗапрос(ШляхHTTP(URL));
	Запит.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запит.УстановитьТелоИзСтроки(ТілоРядок, КодировкаТекста.UTF8);
	Ответ = Соединение.ОтправитьДляОбработки(Запит);
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// Фаза 1: дані + хеші (без фото)
&НаСервере
Функция ВідправитиСинхр(КатегоріїМасив, ПакетТоварів)
	Дані = Новый Структура;
	Дані.Вставить("categories", КатегоріїМасив);
	Дані.Вставить("products", ПакетТоварів);
	Возврат ВідправитиJSON("/1c_exchange/sync", Дані);
КонецФункции

// Фаза 2: фото. Повертає Структуру(Успішно, Помилок) для цього пакета.
&НаСервере
Функция ВідправитиФото(ПакетФото)
	Результат = Новый Структура("Успішно, Помилок", 0, ПакетФото.Количество());
	Дані = Новый Структура;
	Дані.Вставить("images", ПакетФото);
	Попытка
		Відповідь = ВідправитиJSON("/1c_exchange/push_images", Дані);
	Исключение
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Фото", УровеньЖурналаРегистрации.Ошибка,,,
			"Помилка HTTP-запиту push_images: " + ОписаниеОшибки());
		Возврат Результат;
	КонецПопытки;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Відповідь);
		СтруктураВідповіді = ПрочитатьJSON(Чтение, Истина);
		Успішно = 0;
		Если СтруктураВідповіді.Получить("images") <> Неопределено Тогда
			Успішно = Число(СтруктураВідповіді.Получить("images"));
		КонецЕсли;
		Результат.Успішно = Успішно;
		Результат.Помилок = ПакетФото.Количество() - Успішно;
		Если СтруктураВідповіді.Получить("status") = "error" Тогда
			ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Фото", УровеньЖурналаРегистрации.Ошибка,,,
				"Сайт повернув помилку push_images: " + Відповідь);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Фото", УровеньЖурналаРегистрации.Ошибка,,,
			"Не вдалося розібрати відповідь push_images: " + ОписаниеОшибки() + " | Відповідь: " + Відповідь);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Розібрати need_images з відповіді /sync і додати у масив  // НЕ ЗМІНЕНО
&НаСервере
Процедура ЗібратиПотрібніФото(Відповідь, ПотрібніФото)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Відповідь);
		СтруктураВідповіді = ПрочитатьJSON(Чтение, Истина);
		Список = СтруктураВідповіді.Получить("need_images");
		Если ТипЗнч(Список) = Тип("Массив") Тогда
			Для Каждого Ід Из Список Цикл
				ПотрібніФото.Добавить(Ід);
			КонецЦикла;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ВивантаженняНаСайт.Синхр", УровеньЖурналаРегистрации.Ошибка,,,
			ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// --- HTTP-допоміжні функції ---  // НЕ ЗМІНЕНО
&НаСервере
Функция ПодключитисяHTTP(URL)
	URLСтруктура = РазобратьURL(URL);
	Защищене = (URLСтруктура.Схема = "https");
	Порт = ?(Защищене, 443, 80);
	ЗащищенеСоединение = ?(Защищене, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(URLСтруктура.Хост, Порт, , , , 120, ЗащищенеСоединение);
	Возврат Соединение;
КонецФункции

&НаСервере
Функция ШляхHTTP(URL)
	URLСтруктура = РазобратьURL(URL);
	Возврат URLСтруктура.Шлях;
КонецФункции

&НаСервере
Функция РазобратьURL(URL)
	Робоча = URL;
	Схема = "http";
	Если СтрНачинаетсяС(НРег(Робоча), "https://") Тогда
		Схема = "https";
		Робоча = Сред(Робоча, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Робоча), "http://") Тогда
		Схема = "http";
		Робоча = Сред(Робоча, 8);
	КонецЕсли;
	ПозиціяСлеша = Найти(Робоча, "/");
	Если ПозиціяСлеша = 0 Тогда
		Хост = Робоча;
		Шлях = "/";
	Иначе
		Хост = Лев(Робоча, ПозиціяСлеша - 1);
		Шлях = Сред(Робоча, ПозиціяСлеша);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Шлях", Шлях);
	Возврат Результат;
КонецФункции
